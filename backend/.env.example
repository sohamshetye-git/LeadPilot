# Database connection string (defaults to local SQLite; use postgresql://... for PostgreSQL/Neon)
DATABASE_URL=sqlite:///./event_leads.db

# Google Gemini API configuration
# Paste your Gemini API key from https://aistudio.google.com/ below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS configuration (comma-separated origins for production frontend)
# e.g., https://your-app.vercel.app
CORS_ORIGINS=
